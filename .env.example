# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://cadence:cadence_dev_password@localhost:5432/cadence_scheduler?schema=public"

# Redis (BullMQ Scheduled Publishing Queue)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (S3-Compatible Media Storage & Presigned Uploads)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="cadence-media"
R2_PUBLIC_DOMAIN="https://media.cadencestudio.app"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace_with_32_byte_random_hex_secret"
BETTER_AUTH_URL="http://localhost:3000"

